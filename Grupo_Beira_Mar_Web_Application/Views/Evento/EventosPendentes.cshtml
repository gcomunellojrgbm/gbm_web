@model Grupo_Beira_Mar_Web_Application.ViewModels.EventosPendentesViewModel

@{
    
}

<style>
    #statusFKS{
        display: inline;
        margin: 0px;
    }

    #statusFKS span {
        margin-bottom: 5px;
        margin-left: 20px;
    }

    .connection-widget {
        width: 100%;
        max-width: 700px;
    }

    .connection-title {
        font-size: 22px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .connection-subtitle {
        color: #666;
        margin-bottom: 25px;
    }

    .status-row {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .status-label {
        min-width: 170px;
        font-size: 18px;
        font-weight: bold;
        display: inline;
    }

        .status-label.good {
            color: #1fa72f;
        }

        .status-label.warning {
            color: #d68b00;
        }

        .status-label.offline {
            color: #d62828;
        }

    .bar-wrapper {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .bar-background {
        position: relative;
        width: 200px;
        height: 18px;
        border-radius: 999px;
        background: #e5e7eb;
        overflow: hidden;
        border: 1px solid #d1d5db;
        display: flex;
    }

    .segment {
        height: 100%;
        transition: width 0.4s ease;
    }

    .green {
        background: #20b339;
        width: 0;
    }

    .yellow {
        background: #f5b400;
        width: 0;
    }

    .red {
        background: #e53935;
        width: 0;
    }

    .time-display {
        margin-left: 20px;
        min-width: 110px;
        font-size: 14px;
        font-weight: bold;
    }

    .seconds-display {
        display: block;
        font-size: 14px;
        font-weight: normal;
        color: #666;
        margin-top: 4px;
    }

    .legend {
        margin-top: 18px;
        font-size: 14px;
        color: #666;
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

        .legend span {
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
    }

        .dot.green {
            background: #20b339;
        }

        .dot.yellow {
            background: #f5b400;
        }

        .dot.red {
            background: #e53935;
        }
</style>

<audio id="idAlarmSound" src="~/assets/audio/alarme_01.mp3"></audio>

<div class="page-header">
    <h3 class="fw-bold mb-3">Monitoramento de Eventos</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a href="#">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">Monitoramento</a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">Eventos</a>
        </li>
    </ul>
</div>

<!-- CARDS DE RESUMO -->
<div class="row mb-4">
    <div class="col-12">
        <div class="event-summary-wrapper">
            
            <h4 style="margin-left: 10px;display: inline;">Indicadores da Receptora FKS </h4>
            <div id="statusFKS" style="display: inline;margin: 0px;"></div>
            <div id="statusFKSProgress" style="display: inline;margin: 0px;">
                @* <div id="statusLabel" class="status-label good">
                    Conexão Boa
                </div> *@

                <div class="bar-wrapper">
                    <div class="bar-background">

                        <div id="greenBar" class="segment green"></div>
                        <div id="yellowBar" class="segment yellow"></div>
                        <div id="redBar" class="segment red"></div>

                    </div>

                    <div id="timeDisplay" class="time-display">
                        00:00
                        @* <span id="secondsDisplay" class="seconds-display">
                            0 segundos
                        </span> *@
                    </div>
                </div>
            </div>

            <div class="row event-summary-row g-3">
                @{
                    String[] lstCSSs = new String[] { "alarm", "panic", "connected", "energy", "battery", "disarmed" };
                    String[] lstIcon = new String[] { "bell", "exclamation-triangle", "user", "bolt", "battery-half", "shield-alt" };
                }

                @for (int i = 0; i < 6; i++)
                {
                    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                        <a href="/eventos-fks/@(Model.ResumoFKS[i * 2].id_evento_estado)/@(Model.ResumoFKS[i * 2].decricao)" target="_blank">
                        <div class="fks-card @(lstCSSs[i])">
                            <div class="fks-card-header">
                                

                                <div class="fks-card-main">
                                    <div class="fks-card-title">@(Model.ResumoFKS[i * 2].decricao)</div>
                                </div>
                            </div>

                            <div class="fks-card-content">
                                <div class="fks-card-icon">
                                    <i class="fas fa-@(lstIcon[i])"></i>
                                </div>
                                <div>
                                    <div class="fks-card-value">@(Model.ResumoFKS[i * 2].Qtd)</div>
                                </div>
                            </div>

                            <div class="fks-card-content">
                                
                                <div class="fks-card-footer">
                                    @(Model.ResumoFKS[i * 2 + 1].decricao): @(Model.ResumoFKS[i * 2 + 1].Qtd)
                                </div>
                            </div>

                        </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center">
                    <h4 class="card-title">Eventos Registrados para Atendimento</h4>
                    
                    
                    <span id="eventosLoadingSpinner" class="spinner-border spinner-border-sm text-success d-none" style="margin-left: 10px" role="status" aria-hidden="true"></span>
                    
                    @* Opcional: Botão para adicionar novo evento, se houver essa funcionalidade *@
                    <a href="~/assets/img/help/sound_config.jpg" target="_blank" class="btn btn-primary btn-round ms-auto">
                        <i class="fas fa-volume-up"></i> Configurar Som
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <div class="demo-spinner" id="divLoading">
                        <button class="btn btn-primary" type="button" disabled>
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            <span role="status">Carregando...</span>
                        </button>
                    </div>

                    <table id="multi-filter-select" class="display table table-striped table-hover" style="display:none">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Receptora</th>
                                <th>Conta</th>
                                <th>Nome Cliente</th>
                                <th>Data Evento</th>
                                <th>Tipo Evento</th>

                            </tr>
                        </thead>
                        <tfoot>
                            <tr>
                                <th></th>
                                <th>Receptora</th>
                                <th>Conta</th>
                                <th>Nome Cliente</th>
                                <th>Data Evento</th>
                                <th>Tipo Evento</th>
                                
                            </tr>
                        </tfoot>
                        <tbody>
                            @foreach (var evento in Model.EventosPendentes)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Create" asp-route-id="@evento.IdEvento" asp-route-eventopendente="true" class="btn btn-primary btn-round">
                                            <i class="fas fa-edit"></i>
                                            @(evento.QtdEvento)
                                        </a>
                                    </td>
                                    <td>@(evento.ReceptoraNome)</td>
                                    <td>@(evento.Conta)</td>
                                    <td>@(evento.NomeCliente ?? "N/A")</td> @* Exibe o NomeCliente do ViewModel *@
                                    <td>@(evento.DataEvento?.ToString("dd/MM/yyyy HH:mm:ss"))</td>
                                    <td>@(evento.DisparaSom ? "🚨" : "") @(evento.TipoEvento)</td>
                                    
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var bAlarm = false;

        @{ bool hasSuccessMsg = TempData["SuccessMessage"] != null; }
        @{ bool hasErrorMsg = TempData["ErrorMessage"] != null; }

        if (@(hasSuccessMsg ? "true" : "false")) {
            $.notify({
                icon: 'icon-bell',
                title: 'Sucesso',
                message: '@(TempData["SuccessMessage"])',
            }, {
                type: 'secondary',
                placement: {
                    from: "top",
                    align: "right"
                },
                time: 1000,
            });
        }
        if (@(hasErrorMsg ? "true" : "false")) {
            $.notify({
                icon: 'icon-bell',
                title: 'Erro',
                message: '@(TempData["ErrorMessage"])',
            }, {
                type: 'danger',
                placement: {
                    from: "top",
                    align: "right"
                },
                time: 1000,
            });
        }

        $(document).ready(function () {
            $('#multi-filter-select').DataTable({
                "pageLength": 5,
                initComplete: function () {
                    $('#divLoading').hide();
                    $('#multi-filter-select').show();

                    this.api().columns().every(function () {
                        var column = this;
                        var select = $('<select class="form-select"><option value=""></option></select>')
                            .appendTo($(column.footer()).empty())
                            .on('change', function () {
                                var val = $.fn.dataTable.util.escapeRegex(
                                    $(this).val()
                                );
                                column
                                    .search(val ? '^' + val + '$' : '', true, false)
                                    .draw();
                            });
                        column.data().unique().sort().each(function (d, j) {
                            select.append('<option value="' + d + '">' + d + '</option>')
                        });
                    });
                }
            });

            // =========================================================
            // Lógica para verificar novos eventos pendentes via AJAX
            // =========================================================


            // Pega todos os IdEvento da lista da Model e os converte para um array JavaScript
            var lstIds = [@(string.Join(", ", Model.EventosPendentes.Select(e => e.IdEvento.ToString())))] ;
            // Faz um Mapa das quantidades dos eventos de FKS, para identificar variação
            var resumoFKS = '@(string.Join("-", Model.ResumoFKS.Select(e => e.Qtd.ToString())))' ;


            var disparaSom = new URLSearchParams(window.location.search).has("disparaSom")
                    ? new URLSearchParams(window.location.search).get("disparaSom") === "true"
                    : @Html.Raw(Model.EventosPendentes.Count(o => o.DisparaSom) > 0 ? "true" : "false");
            
            if(disparaSom){
                bAlarm = true;
                soundPlay();
            }

            // Função para fazer a requisição AJAX
            function checkEventosPendentes() {

                // Mostra o spinner ao lado do título
                $('#eventosLoadingSpinner').removeClass('d-none');

                $.ajax({
                    url: '@Url.Action("CheckEventosPendentes", "Evento")',
                    type: 'POST',
                    data: { 
                        eventosIds: lstIds,
                        resumoFKS: resumoFKS
                    }, 
                    success: function (data) {
                        setTimeout(() => {
                            $('#eventosLoadingSpinner').addClass('d-none');
                        }, 1000)

                        if (data.reloadPage) {
                            // Se houver novos eventos pendentes, recarrega a página
                            recarregarPagina(data.disparaSom);
                        }

                        //verificar o tempo de resposta do FKS
                        if(data.segundosUltimaMensagemFKS < 40){
                            // avisa que está online
                            $('#statusFKS').html('<span class="badge bg-success">FKS Online</span>');
                        }else if(data.segundosUltimaMensagemFKS < 60){
                            //avisa que a conecão está crítica
                            $('#statusFKS').html('<span class="badge bg-warning text-dark">FKS Conexão Crítica</span>');
                        }else{
                            //avisa que a conecão está offline
                            $('#statusFKS').html('<span class="badge bg-danger">FKS Offline</span>');
                        }

                        atualizarConexao(data.segundosUltimaMensagemFKS);

                        //todo: remover linha abaixo para produção
                        //setTimeout(checkEventosPendentes, 3000);
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.error('Erro na requisição AJAX:', textStatus, errorThrown, jqXHR.responseText);
                    }
                });
            }

            // Chama a função checkEventosPendentes a cada 30 segundos (30000 milissegundos)
            setInterval(checkEventosPendentes, 3000);

            // Opcional: Chamar uma vez ao carregar a página também
            checkEventosPendentes();
        });

        function recarregarPagina(disparaSom) {
            var url = new URL(window.location.href);

            // Atualiza ou adiciona o parâmetro
            url.searchParams.set("disparaSom", disparaSom ? "true" : "false");

            // Faz o reload com a nova URL
            window.location.href = url.toString();
        }
        
        function soundPlay(){
            if(bAlarm){
                idAlarmSound.play();

                Swal.fire({
                    title: '🚨 ATENÇÃO! 🚨',
                    text: 'Existem Eventos Pendentes',
                    
                    confirmButtonText: 'Fechar',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showClass: {
                        popup: 'animate__animated animate__zoomIn animate__faster'
                    }
                }).then((result) => {
                    if (result) {
                        pausaSom();
                    }
                });
                setTimeout(soundPlay, 3000);
            }
            
        }
        
        function pausaSom(){
            idAlarmSound.pause();
            bAlarm = false;
        }

            /*
            CONFIGURAÇÕES PARAMETRIZÁVEIS
        */

        const CONFIG = {
            totalWidth: 200,          // largura total da barra
            redMaxWidth: 30,          // largura máxima da parte vermelha
            goodLimit: 180,           // 3 min (segundos)
            warningLimit: 360,        // 6 min (segundos)
            barHeight: 18
        };


        /*
            FUNÇÃO PRINCIPAL
            Chame assim:
            atualizarConexao(75);
            atualizarConexao(260);
            atualizarConexao(500);
        */

        function atualizarConexao(seconds) {

            const greenBar = document.getElementById("greenBar");
            const yellowBar = document.getElementById("yellowBar");
            const redBar = document.getElementById("redBar");
            //const statusLabel = document.getElementById("statusLabel");
            const timeDisplay = document.getElementById("timeDisplay");
            //const secondsDisplay = document.getElementById("secondsDisplay");

            const greenMaxWidth = CONFIG.totalWidth - CONFIG.redMaxWidth;
            const yellowMaxWidth = greenMaxWidth / 2;
            const greenOnlyWidth = greenMaxWidth / 2;

            let greenWidth = 0;
            let yellowWidth = 0;
            let redWidth = 0;

            let statusText = "";
            let statusClass = "";

            /*
                FAIXA VERDE
                até goodLimit
            */
            if (seconds <= CONFIG.goodLimit) {
                greenWidth = (seconds / CONFIG.goodLimit) * greenOnlyWidth;
                yellowWidth = 0;
                redWidth = 0;

                statusText = "Conexão Boa";
                statusClass = "good";
                // avisa que está online
                $('#statusFKS').html('<span class="badge bg-success">FKS Online</span>');
            }

            /*
                FAIXA AMARELA
                entre goodLimit e warningLimit
            */
            else if (seconds <= CONFIG.warningLimit) {
                greenWidth = greenOnlyWidth;

                yellowWidth =
                    ((seconds - CONFIG.goodLimit) /
                    (CONFIG.warningLimit - CONFIG.goodLimit))
                    * yellowMaxWidth;

                redWidth = 0;

                statusText = "Conexão Crítica";
                statusClass = "warning";
                //avisa que a conecão está crítica
                $('#statusFKS').html('<span class="badge bg-warning text-dark">FKS Conexão Crítica</span>');
            }

            /*
                FAIXA VERMELHA
                acima de warningLimit
            */
            else {
                greenWidth = greenOnlyWidth;
                yellowWidth = yellowMaxWidth;

                const overflow = seconds - CONFIG.warningLimit;

                /*
                    crescimento controlado da parte vermelha
                    aqui usamos 300 segundos como escala visual
                    pode ajustar facilmente
                */
                redWidth = Math.min(
                    (overflow / 150) * CONFIG.redMaxWidth,
                    CONFIG.redMaxWidth
                );

                statusText = "Sem Conexão";
                statusClass = "offline";
                //avisa que a conecão está offline
                $('#statusFKS').html('<span class="badge bg-danger">FKS Offline</span>');
            }

            greenBar.style.width = `${greenWidth}px`;
            yellowBar.style.width = `${yellowWidth}px`;
            redBar.style.width = `${redWidth}px`;

            //statusLabel.className = `status-label ${statusClass}`;
            //statusLabel.innerText = statusText;

            timeDisplay.childNodes[0].nodeValue = formatTime(seconds);
            //secondsDisplay.innerText = `${seconds} segundos`;
        }


        /*
            FORMATA MM:SS
        */

        function formatTime(totalSeconds) {
            const minutes = Math.floor(totalSeconds / 60);
            const seconds = totalSeconds % 60;

            return `${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
        }


        /*
            EXEMPLO DE TESTE
            remova depois
        */

        // let teste = 0;

        // setInterval(() => {
        //     atualizarConexao(teste);
        //     teste += 5;
        // }, 1000);

    </script>
}
